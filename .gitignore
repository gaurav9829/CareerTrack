# Dependencies
node_modules/

# Environment files (NEVER commit secrets)
.env
.env.local
.env.*.local

# Uploaded résumés (user files stay out of git, keep the folder via .gitkeep)
backend/uploads/**
!backend/uploads/resumes
backend/uploads/resumes/*
!backend/uploads/resumes/.gitkeep

# Build output
frontend/dist/
coverage/

# Logs
*.log
npm-debug.log*

# OS / editor junk
.DS_Store
Thumbs.db

# Legacy pre-project scaffolds (left on disk, outside the repo)
client/
server/

# Course material & working docs that are NOT part of the project repo
Minor & Major Project Guidelines*.pdf
AGENTS.md
TaskFlow*/

# Local working files (drafts, scripts) that never belong in the repo
*.draft.md
scripts-local/

# Submission material (course process, not project code)
Submission_Email.txt
